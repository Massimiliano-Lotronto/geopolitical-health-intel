# ══════════════════════════════════════════════════════════
# BrAIn Democracy — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.template .env
# NEVER commit .env to git!
# ══════════════════════════════════════════════════════════

# ── Database (REQUIRED) ──
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── NCBI / PubMed (optional, improves rate limit) ──
NCBI_API_KEY=
NCBI_EMAIL=

# ── Bundestag API (optional) ──
BUNDESTAG_API_KEY=

# ── BfArM DiGA FHIR (optional) ──
DIGA_FHIR_TOKEN=

# ── Supabase (for trends collector) ──
SUPABASE_URL=
SUPABASE_KEY=

# ── AbuseIPDB (for cyber collector) ──
ABUSEIPDB_API_KEY=

# ── Email alerts (optional) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENTS=email1@example.com,email2@example.com

# ── Future: Claude API (for simulation engine) ──
ANTHROPIC_API_KEY=
